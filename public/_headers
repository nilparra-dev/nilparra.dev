# Response headers of the Cloudflare static assets (see wrangler.jsonc).
#
# The Content-Security-Policy is the meta policy of index.html plus
# frame-ancestors, which a meta element cannot express. csp.test.ts fails when
# the two drift apart. The meta stays as the policy for `vite dev` and
# `vite preview`, which do not read this file.
#
# Clipboard access is left out of Permissions-Policy: Mail, Projects and
# Notepad use the async clipboard API.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://api.tavily.com; frame-src https: blob:; object-src 'none'; base-uri 'self'; form-action 'none'; require-trusted-types-for 'script'; trusted-types 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# Vite names these files after a hash of their contents, so a new build never
# reuses a name and they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
