    "@types/node": "^26.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
