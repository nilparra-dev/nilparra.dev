{
  "name": "nilparra-win95",
  "private": true,
  "version": "1.0.0",
  "description": "Personal website of Nil Parra Luna built as an interactive Windows 95 desktop recreation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
