{
  "name": "nilparra-win95",
  "private": true,
  "version": "1.0.0",
  "description": "Personal website of Nil Parra Luna built as an interactive Windows 95 desktop recreation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "prebuild": "npm run assets",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "demo": "npm run build && node scripts/record-demo.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cloudflared": "^0.7.3",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.65.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
